{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ref",
    "sessionId",
    "seq",
    "time",
    "type",
    "data"
  ],
  "properties": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostId",
        "workspaceId",
        "runtimeInstanceId",
        "engineId",
        "nativeSessionId"
      ],
      "properties": {
        "hostId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "runtimeInstanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "engineId": {
          "enum": [
            "codex",
            "claude-code",
            "opencode",
            "deepseek-harness"
          ]
        },
        "nativeSessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "sessionId": {
      "type": "string"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "time": {
      "type": "number"
    },
    "type": {
      "enum": [
        "message.delta",
        "message.completed",
        "tool.updated",
        "agent.updated",
        "run.updated",
        "interaction.created",
        "interaction.closed",
        "model.confirmed",
        "error"
      ]
    },
    "data": {
      "type": "object"
    }
  }
}
