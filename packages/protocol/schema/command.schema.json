{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Maid Café command v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "hostId",
    "clientRequestId",
    "sessionId",
    "ref",
    "action",
    "payload"
  ],
  "properties": {
    "protocolVersion": {
      "const": 2
    },
    "hostId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "clientRequestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostId",
        "workspaceId",
        "runtimeInstanceId",
        "engineId",
        "nativeSessionId"
      ],
      "properties": {
        "hostId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "runtimeInstanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "engineId": {
          "enum": [
            "codex",
            "claude-code",
            "opencode",
            "deepseek-harness"
          ]
        },
        "nativeSessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "action": {
      "enum": [
        "submit",
        "cancel",
        "decide",
        "configure",
        "slash",
        "steer"
      ]
    },
    "payload": {
      "type": "object",
      "required": [
        "expectedGeneration"
      ],
      "properties": {
        "expectedGeneration": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "cancel"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "runId"
            ],
            "properties": {
              "runId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "decide"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "interactionId"
            ],
            "properties": {
              "interactionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "answer": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  ]
}
